{
    "$schema": "https://synodic.github.io/porringer/schema.json",
    "version": "1",
    "name": "Python Dev Environment",
    "description": "Linting, type-checking, and testing tools for Porringer development",
    "author": "Synodic Software",
    "url": "https://github.com/synodic/porringer",
    "packages": {
        "python": [
            {
                "name": "ruff",
                "description": "Fast Python linter and formatter"
            },
            {
                "name": "pyrefly",
                "description": "Python type checker"
            },
            "pytest",
            "pytest-cov",
            "pytest-mock",
            "pytest-asyncio"
        ]
    },
    "tools": {
        "python": [
            {
                "name": "pdm",
                "description": "Python package and dependency manager"
            }
        ]
    }
}