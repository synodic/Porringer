{
    "version": "1",
    "name": "Python Dev Environment",
    "description": "Common linting, formatting, and testing tools for Python development",
    "author": "Synodic Software",
    "url": "https://github.com/synodic/porringer",
    "prerequisites": [
        {
            "plugin": "pip"
        },
        {
            "plugin": "pipx"
        },
        {
            "plugin": "winget",
            "platforms": [
                "win32"
            ]
        },
        {
            "plugin": "apt",
            "platforms": [
                "linux"
            ]
        },
        {
            "plugin": "brew",
            "platforms": [
                "darwin"
            ]
        }
    ],
    "packages": {
        "pip": [
            {
                "name": "ruff",
                "description": "Fast Python linter and formatter"
            },
            {
                "name": "pyrefly",
                "description": "Python type checker"
            },
            "pytest",
            "pytest-cov",
            {
                "name": "pywin32",
                "description": "Python for Win32 extensions",
                "platforms": [
                    "win32"
                ]
            },
            {
                "name": "uvloop",
                "description": "Fast event loop for asyncio",
                "platforms": [
                    "linux",
                    "darwin"
                ]
            }
        ],
        "pipx": [
            {
                "name": "pdm",
                "description": "Python package and dependency manager"
            }
        ]
    }
}